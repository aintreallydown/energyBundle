<h2>{{ 'bundle.energy.h2.1' | trans }}</h2>

	<ul class="naked">

		{% for label, value in field_choices(form.energy) %}
            <li>
				<label class="flex left middle sm">
	                <input 
						class="mr-15"
	                    type="radio"
	                    name="{{ field_name(form.energy) }}" 
	                     {{ field_value(form.energy) == value ? 'checked' : '' }}
	                    value="{{value}}"
	                >
					<img height="35" src="{{ absolute_url(asset('icons/dpe-' ~ value ~ '.svg')) }}">

	                {{ label|replace({'-': 'bundle.energy.range_separator'|trans}) }}

				</label>
            </li>
        {% endfor %}
	</ul>

	{% if form.emission is defined %}

	<h2>{{ 'bundle.energy.h2.2' | trans }}</h2> 

    <ul class="naked">
        {% for label, value in field_choices(form.emission) %}
            <li>
                <label class="flex left middle sm">
                    <input 
                        class="mr-15"
                        type="radio"
                        name="{{ field_name(form.emission) }}" 
                        {{ field_value(form.emission) == value ? 'checked' : '' }}
                        value="{{ value }}"
                    >
                    <img height="35" src="{{ absolute_url(asset('icons/ges-' ~ value ~ '.svg')) }}">
                    {{ label|replace({'-': 'bundle.energy.range_separator'|trans}) }}
                </label>
            </li>
        {% endfor %}
    </ul>
{% endif %}
    