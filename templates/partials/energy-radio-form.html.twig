<h2>{{ 'bundle.energy.h2.1' | trans }}</h2>

<ul class="naked">

    {% for label, value in field_choices(form.energy) %}
        <li>
            <label class="flex left middle sm">
                <input 
                    class="mr-15"
                    type="radio"
                    name="{{ field_name(form.energy) }}" 
                    {{ field_value(form.energy) == value ? 'checked' : '' }}
                    value="{{ value }}"
                >
                <img height="35" src="{{ absolute_url(asset('icons/dpe-' ~ label ~ '.svg')) }}">

				{{dump(value)}}
				{{dump(field_value(form.energy))}}
				{{dump(form.energy.vars)}}
				{{dump(form.energy.vars.choices)}}
				{# {{ label }} #}

                {# {% if value.labelMin is not null and value.labelMax is not null %}
                    {{ value.labelMin ~ ('bundle.energy.range_separator' | trans) ~ value.labelMax }}
                {% else %}
                    {{ value.labelMin is not null ? value.labelMin : value.labelMax }}
                {% endif %} #}
            </label>
        </li>
    {% endfor %}
</ul>

