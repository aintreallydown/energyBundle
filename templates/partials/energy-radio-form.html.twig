<h2>{{ 'bundle.energy.h2.1' | trans }}</h2>

<ul class="naked">

    {% for label, value in field_choices(form.energy) %}
        <li>
            <label class="flex left middle sm">
                <input 
                    class="mr-15"
                    type="radio"
                    name="{{ field_name(form.energy) }}" 
                    {{ field_value(form.energy) == label ? 'checked' : '' }}
                    value="{{ label }}"
                >
                <img height="35" src="{{ absolute_url(asset('icons/dpe-' ~ label ~ '.svg')) }}">

                {% if value.data.valueMin is not null and value.data.valueMax is not null %}
                    {{ value.data.valueMin ~ ('bundle.energy.range_separator' | trans) ~ value.data.valueMax }}
                {% else %}
                    {{ value.data.valueMin is not null ? value.data.valueMin : value.data.valueMax }}
                {% endif %}
            </label>
        </li>
    {% endfor %}
</ul>

